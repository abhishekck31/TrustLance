// Define the database schema using Prisma for PostgreSQL persistence of job metadata.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  jobId        Int      @id @default(autoincrement())
  status       String   @default("PENDING") // PENDING, FUNDED, COMPLETED, FAILED
  description  String
  amount       BigInt    // Use BigInt for precise monetary amounts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}