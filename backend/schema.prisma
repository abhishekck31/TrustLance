datasource db {
  provider = postgresql
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  planName    String
  amount      Float     // Monthly recurring amount
  startDate   DateTime
  status      String    // e.g., ACTIVE, CANCELED
  createdAt   DateTime  @default(now())
}

model MRRMetric {
  id             String    @id @default(cuid())
  monthYear      String    @unique // Format: YYYY-MM (e.g., 2024-05)
  totalMRR       Float
  totalChurn     Float
  calculatedAt   DateTime  @default(now())
}

// Example of how we might store aggregated metrics if needed, though the service will calculate dynamically.
// For this implementation, we focus on using the Subscription model for calculation.