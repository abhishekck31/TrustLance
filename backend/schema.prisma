// Define the database schema using Prisma for persistent storage (for tracking notifications if needed).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipient  String
  message    String
  timestamp   DateTime @default(now())
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

