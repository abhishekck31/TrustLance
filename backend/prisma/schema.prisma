datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model JobMetadataPin {
  id          Int       @id @default(autoincrement())
  jobId       String    @unique // Reference to the original job ID
  ipfsHash    String    @unique // The resulting IPFS hash (CID)
  metadata    Json      // The full serialized metadata payload (for verification/storage if not storing directly on IPFS)
  pinnedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
}