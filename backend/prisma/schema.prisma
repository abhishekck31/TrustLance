datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  listings    Listing[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  price       Float   // Storing price as Float for simplicity, use BigInt/Wei in production
  sellerAddress String // Address of the seller (for off-chain lookup/registration)
  status      String   @default("Active") // Active, Sold, Draft
  createdAt   DateTime @default(now())

  @@index([categoryId])
}

// Note: In a full system, we would also model Users and potentially Token ownership here.