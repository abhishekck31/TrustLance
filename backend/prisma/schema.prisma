// Define the database structure for tracking proof data off-chain
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NftProof {
  id          Int      @id @default(autoincrement())
  projectId   Int      @unique
  proofHash   BigInt    // Store the PoW hash as a large integer
  details     String
  status      String   @default("PENDING_VERIFICATION")
  createdAt   DateTime  @default(now())
}