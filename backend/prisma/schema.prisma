// Define the schema for storing security alerts and monitoring data.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SecurityAlert {
  id          Int      @id @default(autoincrement())
  blockchain  String   // e.g., "Ethereum" or "Polygon"
  address     String   // The address involved in the activity
  reason      String   // Description of the suspicious activity
  amount      BigInt    // Value related to the activity
  timestamp   DateTime @default(now())
  is_resolved Boolean  @default(false)
}