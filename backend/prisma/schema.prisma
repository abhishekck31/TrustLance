datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model to represent the Project NFT linkage and PoW state in the database
model Project {
  id            Int      @id @default(autoincrement())
  projectId     String   @unique // Corresponds to the Blockchain Project ID
  name          String
  status        String   @default("Pending") // Pending, Completed
  proofHash     String?  // The hash linked to the on-chain PoW proof
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}