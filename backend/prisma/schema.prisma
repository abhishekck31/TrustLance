// Prisma Schema definition for PostgreSQL interaction
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Interface to represent the Solidity Marketplace data stored on-chain (or synced)
model Listing {
  id          String @id @default(uuid())
  category    String
  title       String
  price       Float // Stored as Float for simplicity in API, should be BigInt/Wei in production integration
  seller      String
  isSold      Boolean @default(false)
}

model User {
  id          String @id @default(uuid())
  walletAddress String @unique
  name        String?
  listings    Listing[]
}

// Note: In a full setup, we would need models for external contract addresses if interacting directly.