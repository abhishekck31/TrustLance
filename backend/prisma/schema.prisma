// Database schema definition for PostgreSQL persistence (optional, but good for tracking non-immutable metadata)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String @id @default(cuid())
  email     String @unique
  walletAddress String @unique
  // Links to on-chain data (optional, for index lookups)
  onchainBadges Json? 
}

model SkillBadgeRecord {
  id        String @id @default(cuid())
  tokenId   String @unique
  ownerAddress String
  skillName  String
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())

  // Optional: Link to the raw contract data hash for external verification proofs
  contractAddress String? 
}