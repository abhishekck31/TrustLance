datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HiringOpportunity {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  type        String   // e.g., Full-time, Internship, Contract
  description String
  salary      Float?
  postedDate  DateTime
  isActive    Boolean  @default(true)
}