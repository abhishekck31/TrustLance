generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  reputation  Float    @default(0.0) // Placeholder for reputation score
  bio         String?
  portfolioId String?
  skills      Skill[]
  createdAt   DateTime @default(now())
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  // In a real app, this would link to a separate SkillCategory table for better structure.
}

// Placeholder for future expansion (if needed)
model Portfolio {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String
  imageUrl    String?
  user        User      @relation(fields: [userId], references: [id])
}