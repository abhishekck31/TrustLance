datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HiringOpportunity {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  salary      Float
  postedAt    DateTime
  isPublic    Boolean   @default(true)
  // In a real scenario, this might link to an address or contract if opportunities are tokenized
}