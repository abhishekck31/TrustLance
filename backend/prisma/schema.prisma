datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HiringOpportunity {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  type        String   // e.g., Full-time, Contract
  postedAt    DateTime @default(now())
  salary      Float?
}