// Example Prisma Schema for tracking vote results and juror data (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-generator"
}

model Proposal {
  id    Int     @id @default(autoincrement())
  name  String
  result Int
  votes SubmittedVotes []Vote
}

model Vote {
  id          Int      @id @default(autoincrement())
  proposalId  Int
  jurorAddress String // Storing address as string for simplicity in PG setup if not using custom type
  voteAmount  Int
  createdAt   DateTime @default(now())
}