// backend/prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ReputationRecord {
  id          String   @id @default(cuid())
  address     String   // The address involved (e.g., the user)
  timestamp   DateTime
  source      String   // e.g., "Transaction", "Approval"
  change      Int      // Delta applied to the score
  counterparty String // Address of the counterparty
}

model TrustScore {
  id          String   @id @default(cuid())
  address     String   @unique // The address whose score is tracked
  currentScore Int      // The current calculated composite trust score
  lastUpdated DateTime @updatedAt
  records     ReputationRecord[]
}

// This setup assumes the backend manages the complex, materialized view of scores.