generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditFinding {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   // e.g., Critical, High, Medium, Low
  status      String   // e.g., Open, In Progress, Resolved, Closed
  findings    Json     // Detailed findings structure (can be complex)
  reportDate  DateTime
  submittedBy String // User who submitted the finding
  statusHistory Json // History of status changes
  createdAt   DateTime @default(now())
}