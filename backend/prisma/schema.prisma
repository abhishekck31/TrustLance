generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  bookmarks Bookmark[]
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  url         String
  isJob       Boolean  // True for Job, False for Favorite
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

// We need a way to link the blockchain data (which is immutable) 
// with off-chain management. For simplicity here, we focus on the relational model.
// In a real system, a synchronization layer would connect these.