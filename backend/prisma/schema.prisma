datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContractRiskAssessment {
  id          String    @id @default(cuid())
  contractAddress String // The address of the contract being assessed
  ownerAddress String   // Owner's address
  deployTime  Int64      // Deployment timestamp
  contractName String
  riskScore   Int        // AI/ML calculated risk score (0-100)
  isSuspicious Boolean   // True if score > 75
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index(contractAddress)
}