// Define the PostgreSQL schema for dynamic fee configuration.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PlatformFeeConfig {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  feePercentage BigInt // Stored as basis points (e.g., 100 for 1%)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Placeholder for potential token management if needed later
model FeeRecord {
  id          Int      @id @default(autoincrement())
  configId    Int
  amount      BigInt // Total amount involved
  feeApplied  BigInt // Calculated fee amount
  platformFee BigInt // The configured platform fee percentage
}