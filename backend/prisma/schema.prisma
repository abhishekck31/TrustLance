datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Freelancer {
  id            String    @id @default(cuid())
  name          String
  bio           String
  rating        Int       @default(0)
  totalProjects Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Project {
  id             String    @id @default(cuid())
  title          String
  description    String
  budget         Int
  completed      Boolean   @default(false)
  isPublished    Boolean   @default(false)
  creatorId      String
  creator        Freelancer @relation(fields: [creatorId], references: [id])
  createdAt      DateTime  @default(now())
}

// Additional table for advanced search filtering (optional but useful for complex queries)
model FilterCriteria {
  id          String @id @default(cuid())
  name        String
  minRating   Int?
  maxBudget   Int?
  category    String? // e.g., 'WebDev', 'Design'
  searchTerms String
}

// Placeholder for demonstration purposes, actual data would be populated via indexers/queries
generator filterQueries {
  provider = "prisma-client-js"
}

@@index([name])
@@index([category])