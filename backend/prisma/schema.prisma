// Defines the database schema for persistence and analytics.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model to store user cohort definitions derived from on-chain events or off-chain logging.
model Cohort {
  id          Int      @id @default(autoincrement())
  cohortId    Int      @unique
  memberAddress String // Address of the user who started the cohort
  startDateMonth Int     // Month (1-12) the cohort began

  createdAt   DateTime  @default(now())
}

// Model to track monthly activity within a specific cohort for retention calculation.
model CohortActivity {
  id          Int      @id @default(autoincrement())
  cohortId    Int
  activityMonth Int     // Month the activity occurred (e.g., 1 for the first month, 2 for the second)
  userAddress String // Redundant but useful for fast lookups
  metricValue Float   // A quantifiable metric (e.g., total transactions, TVL, total items held)

  cohort      Cohort   @relation(fields: [cohortId], references: [id])
}