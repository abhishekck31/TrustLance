datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RevenueRecord {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  amount    Float    // The actual revenue generated for this period/event
  source    String   // e.g., 'Protocol_A', 'NFT_Sale'
}

// Ensure the schema supports time-series data necessary for forecasting.