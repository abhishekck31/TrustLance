// Define the Prisma schema for PostgreSQL persistence of dispute metadata.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dispute {
  id            Int      @id @default(autoincrement())
  disputeId     Uint256  @unique
  assetOwner    String
  amount       BigInt    // Storing large amounts as BigInt for safety
  isFrozen      Boolean  @default(true)
  disputeReason String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Optional: A table to track token freezes, if we move state slightly off-chain.
model FrozenAsset {
  id           Int      @id @default(autoincrement())
  disputeId    Uint256  @unique
  assetAddress String // The address of the asset that is frozen
  amount      BigInt
  status      String   // e.g., 'PENDING', 'FROZEN', 'RESOLVED'
  createdAt    DateTime @default(now())
}