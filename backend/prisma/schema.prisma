// Define the database structure for bookmarks and potential job listings relationship
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  bookmarks Bookmark[]
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime  @default(now())
  savedByIds  String[] // Links to User IDs who have saved this job (optional, for tracking popularity)
}

model Bookmark {
  id        String    @id @default(cuid())
  userId    String
  jobId     String
  jobTitle  String
  savedAt   DateTime  @default(now())
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])

  @@index([userId, jobId], unique: true) // Ensure a user only bookmarks a specific job once
}