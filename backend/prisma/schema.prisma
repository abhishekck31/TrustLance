datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        Int      @id @default(autoincrement())
  walletAddress String @unique
  name      String?
  createdAt DateTime @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id          Int      @id @default(autoincrement())
  customerId Int
  planName    String
  startDate   DateTime @default(now())
  monthlyPrice Float // The recurring revenue amount
  status      String   // e.g., 'active', 'canceled', 'trial'
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
}

// Optional: A table for aggregated monthly revenue snapshots if performance requires pre-calculation
model MonthlyRevenueSnapshot {
  id          Int      @id @default(autoincrement())
  month       String   @unique // Format YYYY-MM
  totalMRR    Float    // Total MRR for that month
  reportedAt  DateTime @default(now())
}

// Example of an aggregate calculated directly from subscriptions (can be handled in service layer too)
model MonthlyMetric {
  id            Int      @id @default(autoincrement())
  month         String   @unique // YYYY-MM
  totalMRR      Float
  newSubscriptions Int
  churnedCustomers Int
  reportedAt    DateTime @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  TRIAL
  PAST_DUE
}

