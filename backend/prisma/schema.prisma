// Define the database schema for persistence, even if the core logic is on-chain.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Schema to store administrative configurations or off-chain logs related to fees
model PlatformConfig {
  id          Int      @id @default(autoincrement())
  feeBPS      Int      // Fee in Basis Points
  updatedAt   DateTime @updatedAt
  ownerAddress String // Stored as string for flexibility if complex
}

