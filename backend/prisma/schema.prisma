datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PlatformHealth {
  id             Int      @id @default(autoincrement())
  tvl            Float     // Total Value Locked (e.g., in USD)
  totalDisputes  Int       // Total number of active disputes
  completionRate Float     // Calculated completion rate (0.0 to 1.0)
  updatedAt      DateTime  @updated

  createdAt DateTime @default(now())
}