// Defines the database schema for tracking off-chain metadata related to on-chain jobs
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model EscrowJob {
  id          Int      @id @default(autoincrement())
  jobId       Uint256  @unique
  funderAddress String
  executorAddress String
  amount      BigInt    // Amount in Wei or smallest unit if dealing with token conversions
  status      String    // PENDING_FUNDING, FUNDED, COMPLETED, FAILED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Note: In a full implementation, we would link this model to on-chain events or use external indexing.