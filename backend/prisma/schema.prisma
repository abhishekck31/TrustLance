datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SuspiciousActivity {
  id          Int      @id @default(autoincrement())
  userAddress String   // Storing as string for flexibility, could use BigInt/Text depending on context
  amount      BigInt    // Use BigInt for large amounts
  reason      String
  timestamp   DateTime  @default(now())
  isReported  Boolean   @default(false)
}