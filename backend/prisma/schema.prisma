datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-generator"
}

model Proposal {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String // e.g., DRAFT, ACTIVE, EXECUTED
  body        String // Full text of the proposal description
  aiSummary   String? // The AI-generated summary
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updated()
}