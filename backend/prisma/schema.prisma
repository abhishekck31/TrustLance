// Define the schema for PostgreSQL interaction, including necessary relations for talent featuring.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Talent {
  id            String    @id @default(cuid())
  name          String
  description   String
  ownerAddress  String // Ethereum address of the talent owner
  isFeatured    Boolean   @default(false)
  featuredTier UInt32    @default(1) // 1: Basic, 2: Premium
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerAddress])
}

// Add a separate model for tracking featured status if the contract calls are too complex to fully mirror in DB schema directly.
// For simplicity here, we will rely on the direct read from contracts but define a simple structure.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  walletAddress String    @unique // Ethereum address of the user
  createdAt     DateTime  @default(now())
}

// Model for tracking featured talent lists (to optimize frontend fetching)
model FeaturedTalentList {
  id            String    @id @default(cuid())
  talentId      String    @unique
  tier          Int       // Corresponds to featuredTier from contract
  talentName    String
  ownerAddress  String

  talent        Talent? @relation(fields: [talentId], references: [id])
}


