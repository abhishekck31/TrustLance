datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DisputeEvidence {
  id             Int      @id @default(autoincrement())
  title          String
  submissionData String   // The raw text or data submitted
  evidencePath   String?   // Path to stored evidence (simulated)
  analysisResult String?   // The AI summary generated
  createdAt      DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
}