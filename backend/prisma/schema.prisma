// Prisma Schema definition for the backend data persistence

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PlatformHealthData {
  id              Int      @id @default(autoincrement())
  platformName    String   @unique
  tvl             BigInt    // Total Value Locked (using BigInt for large numbers)
  totalDisputes   BigInt
  completedDisputes BigInt
  disputeCompletionRate Float // Percentage 0.0 to 100.0
  updatedAt       DateTime @updatedAt

  @@index([platformName])
}