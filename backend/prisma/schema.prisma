// TrustLance Backend Database Schema (PostgreSQL via Prisma)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id            Int      @id @default(autoincrement())
  creator       String
  projectName  String
  statusId     Int       // Tracks the current stage of the timeline (0=Created, 1=Funded, ..., 5=Released)
  createdAt     DateTime  @default(now())
  fundedAt      DateTime?
  milestoneAt   DateTime?
  approvedAt    DateTime?
  releasedAt    DateTime?

  @@index([fundedAt])
  @@index([milestoneAt])
}

// NOTE: For a real application, we would also need a separate table for immutable blockchain events if indexing relies solely on the chain. 
// Here, we focus on an optimized relational view for backend querying.