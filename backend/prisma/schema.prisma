generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TreasuryHolding {
  id          Int      @id @default(autoincrement())
  address     String   @unique // Owner/DAO address
  tokenSymbol String   // e.g., "ETH", "USDC"
  balance     BigInt    // Amount held (using BigInt for precision)
  timestamp   DateTime @default(now())
}

model TreasuryFlow {
  id           Int      @id @default(autoincrement())
  fromAddress  String
  toAddress    String
  token        String   // The token involved in the flow (e.g., "ETH")
  amount       BigInt
  timestamp    DateTime @default(now())
}

// Note: In a real application, these models would be populated by Web3 indexers or backend processing of contract events.