import { fetchUserProfile } from '@/lib/api'; // Assume this function handles the API call
import ProfileDashboard from '@/components/ProfileDashboard';

interface ProfilePageProps {
  params: {
    username: string;
  };
}

// This page handles fetching and displaying the full profile.
export default async function ProfilePage({ params }: ProfilePageProps) {
  const username = params.username;

  // Simulate fetching data from the backend API
  const profileData = await fetchUserProfile(username);

  if (!profileData) {
    return (
      <div className="min-h-screen bg-gray-50 p-8">
        <h1 className="text-3xl font-bold text-red-600">404 - Profile Not Found</h1>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 p-4 sm:p-8">
      <header className="mb-8 border-b pb-4">
        <h1 className="text-5xl font-extrabold text-gray-900">{profileData.username}'s Profile</h1>
      </header>
      
      {/* Main Dashboard Content */}
      <main className="space-y-12">
        
        {/* 1. Reputation Score Card */}
        <div className="bg-white shadow-xl rounded-lg p-6 border-t-4 border-indigo-500">
          <h2 className="text-3xl font-bold text-gray-800 mb-2 flex items-center">
            Reputation Score
          </h2>
          <p className={`text-6xl font-extrabold ${profileData.reputation > 500 ? 'text-green-600' : profileData.reputation > 100 ? 'text-yellow-600' : 'text-red-600'}`}>
            {profileData.reputation.toFixed(1)} / 1000
          </p>
          <p className="mt-2 text-gray-600">Verified Trust Level</p>
        </div>

        {/* 2. Portfolio Section */}
        <section className="space-y-6">
          <h3 className="text-3xl font-bold text-gray-900 border-b pb-2">Portfolio</h3>
          {profileData.portfolio ? (
            <div className="grid md:grid-cols-2 gap-6">
              {profileData.portfolio.items.map((item: any) => (
                <div key={item.id} className="bg-white p-5 rounded-lg shadow hover:shadow-md transition duration-300 border border-gray-100">
                  <h4 className="text-xl font-semibold text-indigo-700">{item.title}</h4>
                  <p className="mt-2 text-gray-600 truncate">{item.description}</p>
                  {/* Placeholder for image/link */}
                  <a href="#" className="mt-3 inline-block text-sm text-blue-500 hover:text-blue-700 font-medium">View Project →</a>
                </div>
              ))}
            </div>
          ) : (
            <p className="text-gray-500 italic p-4 bg-white rounded-lg">No portfolio items found for this user yet.</p>
          )}
        </section>

        {/* 3. Skills Tags Section */}
        <section>
          <h3 className="text-3xl font-bold text-gray-900 border-b pb-2">Skills & Expertise</h3>
          <div className="flex flex-wrap gap-3">
            {profileData.skills && profileData.skills.map((skill: any) => (
              <span
                key={skill.id}
                className="px-4 py-2 bg-indigo-100 text-indigo-800 font-medium rounded-full shadow-sm transition hover:bg-indigo-200"
              >
                {skill.name}
              </span>
            ))}
          </div>
        </section>

      </main>
    </div>
  );
}


