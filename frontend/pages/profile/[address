// Next.js dynamic route for fetching and displaying a public freelancer profile page
import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import axios from 'axios'; // Using axios for HTTP requests

// Component to display the profile information
export default function FreelancerProfilePage() {
    const router = useRouter();
    const { address } = router.query;
    const [profile, setProfile] = useState(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(null);

    useEffect(() => {
        if (!address) {
            setError("No freelancer address provided.");
            setLoading(false);
            return;
        }

        const fetchProfile = async () => {
            try {
                // Fetch data from the backend API
                const response = await axios.get(`http://localhost:3001/api/profile/${address}`);
                setProfile(response.data);
            } catch (err) {
                console.error("Error fetching profile:", err);
                setError("Failed to load profile data. Check if the address is valid.");
                setProfile(null);
            } finally {
                setLoading(false);
            }
        };

        fetchProfile();
    }, [address]); // Rerun whenever the route parameter 'address' changes

    if (loading) {
        return <div className="p-8 text-center text-lg">Loading profile...</div>;
    }

    if (error) {
        return <div className="p-8 text-center text-red-600">Error: {error}</div>;
    }

    if (!profile) {
        return <div className="p-8 text-center text-red-600">Profile not found for this address.</div>;
    }

    // Render the public profile page
    return (
        <div className="min-h-screen bg-gray-50 p-4 sm:p-8">
            <header className="mb-8 border-b pb-4">
                <h1 className="text-4xl font-bold text-gray-900 mb-2">{profile.bio}</h1>
                <p className="text-lg text-indigo-600 font-medium">Freelancer Profile</p>
            </header>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {/* Profile Card */}
                <div className="md:col-span-2 bg-white p-6 shadow-lg rounded-xl">
                    <h2 className="text-2xl font-semibold mb-4 text-gray-800">About Me</h2>
                    <p className="text-gray-700 leading-relaxed">{profile.bio}</p>
                </div>

                {/* Details Card */}
                <div className="bg-indigo-50 p-6 shadow-lg rounded-xl border-l-4 border-indigo-500">
                    <h2 className="text-2xl font-semibold mb-4 text-gray-800">Details</h2>
                    <div className="space-y-3">
                        <p><strong>Rating:</strong> <span className="font-bold text-green-600">{profile.rating} / 5.0</span></p>
                        <p><strong>Website:</strong> <a href={profile.websiteUrl} target="_blank" rel="noopener noreferrer" className="text-blue-600 hover:underline">{profile.websiteUrl}</a></p>
                    </div>
                </div>
            </div>

            <footer className="mt-12 pt-6 border-t text-center text-sm text-gray-500">
                Profile Data retrieved from TrustLance system.
            </footer>
        </div>
    );
}